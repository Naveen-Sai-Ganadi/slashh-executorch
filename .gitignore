# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Autonomy OS generated state
.claude/state/green.json
.claude/state/run-log.jsonl
.claude/settings.local.json

# Credentials — never commit (live AI Hub token lives in ~/.qai_hub/client.ini)
client.ini
*.token
.env

# Local datasets (real audio is downloaded, not vendored)
data/
datasets/

# Large / generated model artifacts — built on demand, never vendored.
# The tiny reference StressNet (assets/stress_model.pt[e]) stays tracked; the
# big teacher graphs, NPU context binaries and ONNX/TorchScript exports do not.
assets/*.onnx
assets/*.ts.pt
assets/*.bin
assets/teacher_*.pte
assets/stressnet_*.pte

# Vendored heavy toolchains / SDKs (QAIRT, ~GBs)
.qairt/

# Experiment tracking
wandb/

# Android build / IDE artifacts (the app source tree is tracked; these are not)
android/.gradle/
android/.idea/
android/app/build/
android/local.properties

# Web frontend (Vite/React/TanStack) — deps + intermediate build output.
# NOTE: the built Vite bundle under android/app/src/main/assets/www/ IS tracked
# (it ships in the APK); only node_modules and stray build dirs are ignored.
# Deliberately NO blanket *.pte/*.pt/*.bin here — those model assets are tracked
# (see .gitattributes for the LFS rules).
node_modules/
dist/
dist-ssr/
.output/
.vinxi/
.tanstack/
.nitro/
.wrangler/
.dev.vars
*.local
*.log
npm-debug.log*

# Whisper Tiny QNN context binaries (~117MB) — staged to device, not vendored.
tools/whisper/whisper_tiny_qnn/*.bin
