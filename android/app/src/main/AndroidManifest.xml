<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone only. NO INTERNET permission: the whole point is that audio
         and results never leave the device (plan §5, airplane-mode hardening). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Local notifications only (relief nudges). Still NO INTERNET permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Continuous background stress monitor: a foreground service keeps the mic
         pipeline alive while the app UI is closed. Type "microphone" is the only
         capability it needs. Still NO INTERNET permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:allowBackup="true"
        android:label="Slashh"
        android:supportsRtl="true"
        android:theme="@style/Theme.Slashh">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Slashh"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Always-on background stress monitor. foregroundServiceType=microphone
             is required on Android 14+ to hold the mic from a foreground service. -->
        <service
            android:name=".StressMonitorService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
